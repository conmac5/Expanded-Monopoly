            message = ""

        if instruction_button.draw(screen):

            screen_state = "instructions"


    # REGISTER

    elif screen_state == "register":

        draw_centered_text(
            "REGISTER",
            title_font,
            white_text,
            screen_width // 2,
            70
        )

        draw_text(
            "Username:",
            small_font,
            white_text,
            250,
            155
        )

        draw_text(
            "Password:",
            small_font,
            white_text,
            250,
            225
        )

        draw_text(
            "Confirm:",
            small_font,
            white_text,
            250,
            295
        )

        register_username_box.draw(screen)

        register_password_box.draw(
            screen,
            password=True
        )

        register_password2_box.draw(
            screen,
            password=True
        )

        if message != "":

            draw_centered_text(
                message,
                small_font,
                message_colour,
                screen_width // 2,
                390
            )

        if create_account_button.draw(screen):

            success, result = register(
                register_username_box.text,
                register_password_box.text,
                register_password2_box.text
            )

            message = result

            if success:

                message_colour = green

                register_username_box.text = ""
                register_password_box.text = ""
                register_password2_box.text = ""

                screen_state = "login"

            else:

                message_colour = red

        if back_button.draw(screen):

            screen_state = "menu"
            message = ""


    # LOGIN

    elif screen_state == "login":

        draw_centered_text(
            "LOGIN",
            title_font,
            white_text,
            screen_width // 2,
            80
        )

        draw_text(
            "Username:",
            small_font,
            white_text,
            250,
            195
        )

        draw_text(
            "Password:",
            small_font,
            white_text,
            250,
            265
        )

        login_username_box.draw(screen)

        login_password_box.draw(
            screen,
            password=True
        )

        if message != "":

            draw_centered_text(
                message,
                small_font,
                message_colour,
                screen_width // 2,
                430
            )

        if login_submit_button.draw(screen):

            username = login_username_box.text
            password = login_password_box.text

            if login(username, password):

                logged_in_username = username

                message = "Login successful!"
                message_colour = green

                login_username_box.text = ""
                login_password_box.text = ""

                screen_state = "game_menu"

            else:

                message = "Incorrect username or password!"
                message_colour = red

        if back_button.draw(screen):

            screen_state = "menu"
            message = ""


    # GAME MENU

    elif screen_state == "game_menu":

        draw_centered_text(
            "MONOPOLY GAME",
            title_font,
            white_text,
            screen_width // 2,
            80
        )

        draw_centered_text(
            "Logged in as: " + logged_in_username,
            small_font,
            white_text,
            screen_width // 2,
            145
        )

        if start_game_button.draw(screen):

            selected_mode = None
            selected_piece = None

            screen_state = "mode_selection"

        if wins_button.draw(screen):

            screen_state = "wins"

        if logout_button.draw(screen):

            logged_in_username = ""
            selected_mode = None
            selected_piece = None

            screen_state = "menu"


    # MODE SELECTION

    elif screen_state == "mode_selection":

        draw_mode_selection()

        if back_button.draw(screen):

            screen_state = "game_menu"

        if selected_mode is not None:

            if continue_button.draw(screen):

                selected_piece = None
                screen_state = "piece_selection"


    # PIECE SELECTION
    elif screen_state == "piece_selection":
        draw_piece_selection()
        if back_button.draw(screen):
            screen_state = "mode_selection"
        if selected_piece is not None:
            if continue_button.draw(screen):
                screen_state = "game_ready"

    # GAME READY
    elif screen_state == "game_ready":
        draw_game_start()
        if back_button.draw(screen):
            screen_state = "piece_selection"
        if start_game_button.draw(screen):
            # The actual Monopoly board will eventually
            # be launched here.
            screen_state = "game_menu"


    # WINS
    elif screen_state == "wins":
        draw_wins_screen()
        if back_button.draw(screen):
            screen_state = "game_menu"
    # INSTRUCTIONS
    elif screen_state == "instructions":
        draw_centered_text(
            "INSTRUCTIONS",
            title_font,
            white_text,
            screen_width // 2,
            70
        )

        instructions = [
            "1. Create an account or login.",
            "2. Select a Monopoly game mode.",
            "3. Select your Monopoly playing piece.",
            "4. Start the game.",
            "5. Your wins are stored in users.csv.",
            "6. Check Wins displays the current win records."
        ]

        y = 170

        for instruction in instructions:

            draw_text(
                instruction,
                small_font,
                white_text,
                180,
                y
            )

            y += 55

        if back_button.draw(screen):

            screen_state = "menu"

    # UPDATE DISPLAY

    pygame.display.flip()

    # Limit game to 60 FPS

    clock.tick(60)

# CLOSE PYGAME


pygame.quit()
