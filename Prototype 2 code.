# CSV FUNCTIONS

# Register a new account

def register(username, password, password2):

    if username == "" or password == "" or password2 == "":
        return False, "Please fill in all boxes!"

    if password != password2:
        return False, "Passwords do not match!"

    if os.path.exists("users.csv"):

        with open("users.csv", mode="r", newline="") as f:

            reader = csv.reader(f)

            for row in reader:

                if len(row) >= 1:

                    if row[0] == username:
                        return False, "Username already exists!"

    # Username, password, number of wins
    with open("users.csv", mode="a", newline="") as f:

        writer = csv.writer(f)
        writer.writerow([username, password, 0])

    return True, "Account created! Please login."

# Login to an existing account

def login(username, password):

    if not os.path.exists("users.csv"):
        return False

    with open("users.csv", mode="r", newline="") as f:

        reader = csv.reader(f)

        for row in reader:

            if len(row) >= 2:

                if row[0] == username and row[1] == password:
                    return True

    return False


# WINS FUNCTIONS

def get_wins():

    players = []

    if not os.path.exists("users.csv"):
        return players

    with open("users.csv", mode="r", newline="") as f:

        reader = csv.reader(f)

        for row in reader:

            if len(row) >= 3:

                username = row[0]

                try:
                    wins = int(row[2])
                except ValueError:
                    wins = 0

                players.append((username, wins))

    return players


def add_win(username):

    if not os.path.exists("users.csv"):
        return

    rows = []

    with open("users.csv", mode="r", newline="") as f:

        reader = csv.reader(f)

        for row in reader:

            if len(row) >= 3:

                if row[0] == username:

                    try:
                        row[2] = str(int(row[2]) + 1)
                    except ValueError:
                        row[2] = "1"

            rows.append(row)

    with open("users.csv", mode="w", newline="") as f:

        writer = csv.writer(f)
        writer.writerows(rows)


# BUTTON CLASS

def create_button_image(text,width,height,bg_colour,text_colour,border_colour):

    surface = pygame.Surface((width, height), pygame.SRCALPHA)

    pygame.draw.rect(surface,bg_colour,(0, 0, width, height))

    pygame.draw.rect(surface,border_colour,(0, 0, width, height),4)

    button_font = pygame.font.SysFont("Arial",25,bold=True)

    text_surface = button_font.render(text.upper(),True,text_colour)

    text_rect = text_surface.get_rect(center=(width // 2, height // 2))

    surface.blit(text_surface, text_rect)

    return surface


class Button:

    def __init__(self, x, y, image, scale=1):

        width = image.get_width()
        height = image.get_height()

        self.image = pygame.transform.scale(image,(int(width * scale),int(height * scale)))

        self.rect = self.image.get_rect()

        self.rect.topleft = (x, y)

        self.clicked = False

    def draw(self, surface):

        action = False

        pos = pygame.mouse.get_pos()

        if self.rect.collidepoint(pos):

            if pygame.mouse.get_pressed()[0] == 1:

                if self.clicked is False:

                    self.clicked = True
                    action = True

        if pygame.mouse.get_pressed()[0] == 0:
            self.clicked = False

        surface.blit(self.image,(self.rect.x, self.rect.y))

        return action


# INPUT BOX

class InputBox:

    def __init__(self, x, y, width, height):

        self.rect = pygame.Rect(x,y,width,height)

        self.text = ""
        self.active = False

    def draw(self, screen, password=False):

        if self.active:
            colour = white
        else:
            colour = (190, 190, 190)

        pygame.draw.rect(screen,colour,self.rect)

        pygame.draw.rect(screen,black,self.rect,2)

        if password:
            display_text = "*" * len(self.text)
        else:
            display_text = self.text

        text_surface = small_font.render(display_text,True,black)
        screen.blit(text_surface,(self.rect.x + 10,self.rect.y + 8))

    #handle_event is now inside InputBox

    def handle_event(self, event):

        if event.type == pygame.MOUSEBUTTONDOWN:

            if self.rect.collidepoint(event.pos):
                self.active = True
            else:
                self.active = False

        if event.type == pygame.KEYDOWN:

            if self.active:

                if event.key == pygame.K_BACKSPACE:

                    self.text = self.text[:-1]

                elif event.key == pygame.K_RETURN:

                    pass

                elif len(self.text) < 25:

                    self.text += event.unicode


